# 智购参谋 —— 环境变量样例
#
# 用法：把本文件复制为 .env 后按需填写。
#       cp .env.example .env          (Git Bash / macOS / Linux)
#       copy .env.example .env        (Windows CMD)
#
# 重要：.env 已在 .gitignore 中排除，不会被提交。请勿把真实密钥写进本样例文件。
#
# 不填任何一项也能完整运行——应用会自动进入「本地演示模式」，
# 商品筛选、规则评分、比较与基础推荐全部可用，且不发起任何网络请求。


# ============================================================
# 大模型 API（可选）
# ============================================================
# 填写 API 密钥后启用「AI 增强模式」，用于自然语言需求理解与推荐解释。
# 留空则运行在本地演示模式。
ZHIGOU_LLM_API_KEY=

# 服务端点。默认指向 OpenAI 兼容地址；
# 换用其他兼容服务（自建代理、国内厂商兼容接口等）时改这里。
ZHIGOU_LLM_BASE_URL=https://api.openai.com/v1

# 模型名。
ZHIGOU_LLM_MODEL=gpt-4o-mini

# 单次请求超时秒数。超时会自动降级到本地规则模式，不会中断分析。
ZHIGOU_LLM_TIMEOUT=20


# ============================================================
# 本地路径（可选，通常不用改）
# ============================================================
# 商品数据文件路径，默认为 <项目根>/data/products.json
# ZHIGOU_PRODUCTS_PATH=

# SQLite 数据库路径，默认为 <项目根>/storage/zhigou.db
# ZHIGOU_DB_PATH=
