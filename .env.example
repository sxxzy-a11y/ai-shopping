# 智购参谋 —— 环境变量样例
#
# 用法：把本文件复制为 .env 后按需填写。
#       cp .env.example .env          (Git Bash / macOS / Linux)
#       copy .env.example .env        (Windows CMD)
#
# 重要：.env 已在 .gitignore 中排除，不会被提交。请勿把真实密钥写进本样例文件。
#
# 不填任何一项也能完整运行——应用会自动进入「本地演示模式」，
# 商品筛选、规则评分、比较与基础推荐全部可用，且不发起任何网络请求。


# ============================================================
# 大模型 API（可选）
# ============================================================
# 填写 API 密钥后启用「AI 增强模式」，用于自然语言需求理解与推荐解释。
# 留空则运行在本地演示模式。
ZHIGOU_LLM_API_KEY=

# 服务端点。本项目用 httpx 直连 OpenAI 兼容接口，换服务商只需改这里。
# 常见取值：
#   https://api.deepseek.com/v1   （DeepSeek，模型名 deepseek-flash / deepseek-v4-pro）
#   https://api.openai.com/v1     （OpenAI）
#   自建代理的兼容地址
ZHIGOU_LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名。
ZHIGOU_LLM_MODEL=deepseek-flash

# 单次请求超时秒数。超时会自动降级到本地规则模式，不会中断分析。
ZHIGOU_LLM_TIMEOUT=60

# 单次回复的 token 上限。
# 注意：推理模型（如 deepseek-flash / deepseek-v4-pro）的**推理过程也计入
# 这个额度**。给小了会出现「正文为空、finish_reason=length」，应用会当作
# 失败并降级到本地规则模式。
ZHIGOU_LLM_MAX_TOKENS=2000


# ============================================================
# 初始管理员（可选，但建议配）
# ============================================================
# 首次启动时**账号表为空**才会用到这两个变量，之后改了也不生效——
# 管理员已经建好了，改环境变量不会悄悄把别人变成管理员。
#
# 不配的话，系统会生成一个随机密码创建初始管理员，并在终端**打印一次**，
# 请登录后立即修改。
ZHIGOU_ADMIN_USERNAME=admin
ZHIGOU_ADMIN_PASSWORD=

# 注意：注册是开放的——任何能访问到该地址的人都能创建账号（普通用户）。
# 演示时请只绑定本机地址，不要暴露到公网。详见 docs/auth-boundary.md。


# ============================================================
# 本地路径（可选，通常不用改）
# ============================================================
# 商品数据文件路径，默认为 <项目根>/data/products.json
# ZHIGOU_PRODUCTS_PATH=

# SQLite 数据库路径（历史库：账号、历史、收藏、偏好），
# 默认为 <项目根>/storage/zhigou.db
# ZHIGOU_DB_PATH=

# 商品库路径，默认为 <项目根>/storage/products.db
# ZHIGOU_PRODUCTS_DB_PATH=

# 【已退役】单用户时期的全局偏好文件。
# 偏好现在按用户存在数据库里；这个文件若存在，首次启动时会被收编成
# 「新用户的初始偏好模板」并改名为 settings.json.bak。
# ZHIGOU_SETTINGS_PATH=
