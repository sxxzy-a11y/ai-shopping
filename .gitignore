# --- 密钥与本地配置（绝不入库）---
.env

# --- 本地数据库 ---
storage/
*.db
*.sqlite
*.sqlite3

# --- 运行日志（app.py 写入，可能含商品路径等信息）---
*.log

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- 虚拟环境 ---
.venv/
venv/
env/

# --- 测试与覆盖率 ---
.pytest_cache/
.coverage
htmlcov/

# --- Node（前端依赖与构建产物，不入库） ---
node_modules/
frontend/dist/

# --- 编辑器与系统 ---
.idea/
.vscode/
.DS_Store

# --- Office 临时文件 ---
~$*

# --- data scraping scratch files ---
_scratch*/
_scratch_*.py
_scratch_*

# --- 本机 API 覆盖配置（含密钥） ---
storage/api_config.json

# --- 评测报告 ---
# report.json 提交一份快照供线上演示；本地重跑会更新它
# report.md 是本地生成物，不入库
data/evaluation/report.md

# --- Streamlit local secrets (never commit) ---
.streamlit/secrets.toml

# --- 测试临时目录与残留 ---
.tmp/
.pytest-tmp/
pytest-of-*/
*.db-wal
*.db-shm

# --- 编辑器本地配置（含本机偏好，不入库）---
.codebuddy/

# --- 开发过程记录（保留在本机用于续做，不随成品发布）---
Plan/
.ai-memory/

# --- 冒烟测试运行产物（每次跑都会变，不入库）---
submission/screenshots/smoke-*.png
